{
  "name": "alexs-craft-calc",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "description": "Alex's Craft Calc — Alien Purple soap & candle calculator, Windows desktop + Android",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "tsx src/lib/calc.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "vite preview --host --port 4173",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
