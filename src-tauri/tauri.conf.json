{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Alex's Craft Calc",
  "version": "1.0.8",
  "identifier": "com.alexscraft.calc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Alex's Craft Calc",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Soap lye & candle wax calculator",
    "longDescription": "Alex's Craft Calc — Alien Purple dual-mode soap and candle calculator with craft wiki, recipe export/import, and offline PWA-grade desktop packaging.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
